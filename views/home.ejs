<!DOCTYPE html>
<html lang="en">
<head>
    <title>URL Shortener</title>
</head>
<body>
    <h1>URL Shortener</h1>

<form action="/url" method="POST">
    <input 
        type="text" 
        name="url" 
        placeholder="Enter long URL" 
        required 
    />
    <input 
        type="text" 
        name="customShortId" 
        placeholder="Optional custom short id" 
    />
    <button type="submit">Generate</button>
</form>

    <h2>All URLs</h2>
    <ul>
        <% if (urls.length > 0) { %>
            <% urls.forEach((url) => { %>
                <li>
                    Short ID: <%= url.shortId %> |
                    Redirect URL: <%= url.redirectURL %> |
                    Clicks: <%= url.visitHistory.length %>
                </li>
            <% }) %>
        <% } else { %>
            <li>No URLs found</li>
        <% } %>
    </ul>
</body>
</html>